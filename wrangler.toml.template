# ─────────────────────────────────────────────────────────────
# Artie – wrangler.toml template
# Copy this file to wrangler.toml and fill in your values.
# Do NOT commit wrangler.toml to source control (it's in .gitignore).
# ─────────────────────────────────────────────────────────────

name = "artie-YOURNAME"          # e.g. artie-kathy, artie-don
compatibility_date = "2024-09-23"
pages_build_output_dir = "dist"

[vars]
ARTIST_NAME = "Your Name or Studio Name"

[[d1_databases]]
binding = "DB"
database_name = "artie-YOURNAME-db"   # must match what you created in Cloudflare
database_id = "PASTE-YOUR-D1-DATABASE-ID-HERE"

[[r2_buckets]]
binding = "IMAGES"
bucket_name = "artie-YOURNAME-images" # must match what you created in Cloudflare
