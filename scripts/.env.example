# Artie provisioning credentials
# Copy this file to scripts/.env, fill in your values, then:
#   source scripts/.env
# (Never commit .env to git)

# Cloudflare account ID — find in Cloudflare dashboard right sidebar
export CLOUDFLARE_ACCOUNT_ID=your-account-id-here

# Cloudflare API token — create at dash.cloudflare.com/profile/api-tokens
# Needs permissions: D1:Edit, Pages:Edit, R2:Edit
export CLOUDFLARE_API_TOKEN=your-api-token-here

# Optional: master viewer PIN that bypasses artist PINs on all sites
export MASTER_VIEWER_PASSWORD=your-master-pin-here
